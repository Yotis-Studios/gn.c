{
  "description": "Conformance vectors for the gn wire protocol (see PROTOCOL.md). Every implementation should pass all of them.",
  "version": 1,
  "value_format": {
    "int": "{ \"t\": \"int\", \"v\": <integer> }",
    "float": "{ \"t\": \"float\", \"v\": <number> | \"NaN\" | \"Infinity\" | \"-Infinity\" }",
    "bool": "{ \"t\": \"bool\", \"v\": <true|false> } (encode only; decodes as u8)",
    "string": "{ \"t\": \"string\", \"v\": <string> } or { \"t\": \"string\", \"repeat\": <string>, \"count\": <n> }",
    "buffer": "{ \"t\": \"buffer\", \"hex\": <hex bytes> }",
    "undefined": "{ \"t\": \"undefined\" } (null in Hemlock)",
    "decoded": "{ \"type\": <wire type name>, \"v\": <value> } or, for buffers, { \"type\": \"buffer\", \"hex\": <hex> }; undefined has no \"v\". Float \"v\" may be \"NaN\", \"Infinity\" or \"-Infinity\"."
  },
  "sections": {
    "encode": "Build a packet from netId + values; the result (size header included) must equal hex.",
    "encode_errors": "Building this packet must fail (throw / return an error) rather than produce bytes.",
    "decode": "Load payload (the bytes after the size field); netId and values must match. A missing netId is null.",
    "frames": "Split a WebSocket message into packets per PROTOCOL.md section 2."
  },
